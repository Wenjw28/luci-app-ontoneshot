#!/bin/sh /etc/rc.common
# 开机重新应用 IPTV 桥接的关键参数
#
# 为什么需要这个服务：
# bridge link set 的 learning / flood / mcast_flood 以及 802.1p 优先级
# 都属于运行时参数，不写入 UCI，network 重启或设备重启后会全部丢失。
# 丢了会出现：
#   - FDB 冲突：网关 MAC 被学到组播 VLAN，机顶盒拿不到 IP
#   - 组播回灌运营商，把 IPTV 认证打断
#
# 所以每次开机后在 network 起来之后重新打一遍。

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ontoneshot reapply-wait
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}
